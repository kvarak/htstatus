# Production settings for deploy/docker-compose.yml. Copy to .env next to it
# (chmod 600). Never commit .env.

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-value

# Hattrick CHPP credentials (https://chpp.hattrick.org/)
CONSUMER_KEY=
CONSUMER_SECRETS=
CALLBACK_URL=https://ht.example.com/login

# Self-hosted GoatCounter pageview tracking, e.g. https://stats.example.com/count;
# empty = no analytics
GOATCOUNTER_URL=

# Hattrick user id that is always admin (e.g. the site owner); empty = only users with role Admin
ADMIN_HT_ID=

# Password of the database in the db container (letters and digits only: it goes into a URL)
POSTGRES_PASSWORD=replace-with-a-database-password

# 0=none ... 3=full debug output in the logs
DEBUG_LEVEL=0
# gunicorn worker processes (2 is plenty on a Pi)
GUNICORN_WORKERS=2

# Image to run (published by CI as ghcr.io/<github owner>/htstatus-web);
# pin a commit SHA tag instead of latest to roll back
WEB_IMAGE=ghcr.io/<github-owner>/htstatus-web:latest
# Port on 127.0.0.1 that nginx proxies to
WEB_PORT=5000

# Backups (backup.sh): days to keep in ./backups
BACKUP_KEEP_DAYS=14
# Optional off-site copy over ssh (key login): user@host or an ssh config alias.
# Leave empty to keep backups on this server only.
BACKUP_REMOTE=
# Folder on that host (relative to its home) and days to keep there
BACKUP_REMOTE_DIR=backup/htplanner
BACKUP_REMOTE_KEEP_DAYS=30
