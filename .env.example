# HT Status - Development Environment Configuration
# Copy this file to .env for development setup

# ================================
# Environment Configuration
# ================================
FLASK_ENV=development
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000

# ================================
# Application Settings
# ================================
APP_NAME=HT Status Development
SECRET_KEY=dev-secret-key-change-for-production
DEBUG_LEVEL=3

# ================================
# Hattrick CHPP API Configuration
# ================================
# Development: Get your keys from: https://chpp.hattrick.org/
CONSUMER_KEY=your-consumer-key
CONSUMER_SECRETS=your-consumer-secret
CALLBACK_URL=http://localhost:5000/login
CHPP_URL=https://chpp.hattrick.org/chppxml.ashx

# ================================
# Database Configuration (Development)
# ================================
# PostgreSQL (Docker Compose default)
POSTGRES_DB=htplanner
POSTGRES_USER=htstatus
POSTGRES_PASSWORD=development
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database URL for SQLAlchemy
DATABASE_URL=postgresql://htstatus:development@localhost:5432/htplanner

# Test Database (separate database for testing)
TEST_POSTGRES_DB=htplanner_test
TEST_DATABASE_URL=postgresql://htstatus:development@localhost:5432/htplanner_test

# ================================
# pgAdmin Configuration (Development Only)
# ================================
PGADMIN_EMAIL=admin@htstatus.local
PGADMIN_PASSWORD=development

# ================================
# Local tooling
# ================================
# Name of the dev PostgreSQL container (docker-compose.yml)
POSTGRES_CONTAINER=htplanner_postgres

# Production server, only for `make db-copy-production` (copies its database
# into the local dev database): ssh target and the folder with its docker-compose.yml
PROD_SERVER=
PROD_APP_DIR=
